.DS_Store
Thumbs.db
.env*
.vercel
*.log

# Presets are personal; don't commit them by accident. The one exception is
# hx-cli's hand-written test fixture, which is ours and the suite needs it.
*.hlx
*.hxb
!/src/hxcli/tests/fixtures/*.hlx
